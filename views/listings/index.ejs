<% layout("/layouts/boilerplate") %>

    <style>
        #filters {
            display: flex;
            align-items: center;
            gap: 1rem;
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 0.75rem;
            margin-bottom: 1rem;
            margin-top: 2rem;
        }

        #filter-scroll {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: 1.5rem;
            overflow-x: auto;
            padding-bottom: 0.25rem;
            flex: 1;
            scrollbar-width: none;
        }

        #filter-scroll::-webkit-scrollbar {
            display: none;
        }

        .filter {
            text-align: center;
            flex: 0 0 auto;
            opacity: 0.6;
            transition: opacity 0.2s ease;
        }

        .filter:hover {
            opacity: 1;
            cursor: pointer;
        }

        .filter.active {
            opacity: 1;
            border-bottom: 2px solid #222;
            padding-bottom: 0.25rem;
        }

        .filter p {
            font-size: 0.75rem;
            margin-bottom: 0;
            margin-top: 0.25rem;
        }

        .filter i {
            font-size: 1.3rem;
        }

        .listing-link {
            text-decoration: none;
            color: inherit;
        }

        .listing-cards {
            border: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .listing-cards:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        .tax-toggle label {
            font-family: "Plus Jakarta Sans", sans-serif;
            font-size: 1rem;
        }
    </style>

    <body>
        <!-- <h2>ALL LISTINGS</h2> -->

        <!-- <form method ="GET"action="/listings/new">
        <button>Create new Listing</button>
    </form> -->


        <div id="filters">
            <div id="filter-scroll">
                <div class="filter">
                    <div><i class="fa-solid fa-fire"></i>
                        <p>Trending</p>
                    </div>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-bed"></i>
                        <p>Rooms</p>
                    </div>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-mountain-city"></i>
                        <p>Mountain City</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-mountain"></i>
                        <p>Mountain</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-brands fa-fort-awesome"></i>
                        <p>Castle</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-person-swimming"></i>
                        <p>Pool</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-fire-burner"></i>
                        <p>Camping</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-cow"></i>
                        <p>Farms</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-regular fa-snowflake"></i>
                        <p>Arctic</p>
                    </div>
                </div>

            </div>
            <div class="tax-toggle flex-shrink-0">
                <div class="form-check-reverse form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label" for="switchCheckDefault">Display total after Taxes</label>
                </div>
            </div>
        </div>



        <div class="row row-cols-lg-3 row-cols-md-2  row-cols-sm-1 row-cols-xs-1 mt-3">
            <% for(let listings of allListings){ %>
                <a href="/listings/<%= listings._id %>" class="listing-link">
                    <div class="card col listing-cards">
                        <img src=<%=listings.image.url %>
                        class="card-img-top"
                        alt="listings.image"
                        style="height: 20rem;"
                        />
                        <div class="card-img-overlay"> </div>
                        <div class="card-body">
                            <p class="card-text">
                                <b>
                                    <%= listings.title%> <br />
                                </b>
                                &#8377; <%= listings.price.toLocaleString("en-IN") %> / night
                            </p>
                        </div>
                    </div>
                </a>
                <%}%>
        </div>

        <script>
            document.querySelectorAll(".filter").forEach(f => {
                f.addEventListener("click", () => {
                    document.querySelectorAll(".filter").forEach(el => el.classList.remove("active"));
                    f.classList.add("active");
                });
            });

            let taxSwitch = document.getElementById("switchCheckDefault");
            taxSwitch.addEventListener("click", () => {
                console.log("Clicked")
            })
        </script>
    </body>