<% layout("/layouts/boilerplate") %>

    <style>
        #filters {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        #filter-scroll {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: 1rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
            flex: 1;
        }

        .filter {
            text-align: center;
            flex: 0 0 auto;
            opacity: 0.7;
        }

        .filter:hover {
            opacity: 1;
            cursor: pointer;
        }

        .filter p {
            font-size: 0.8rem;
            margin-bottom: 0;
        }
    </style>

    <body>
        <!-- <h2>ALL LISTINGS</h2> -->

        <!-- <form method ="GET"action="/listings/new">
        <button>Create new Listing</button>
    </form> -->


        <div id="filters">
            <div id="filter-scroll">
                <div class="filter">
                    <div><i class="fa-solid fa-fire"></i>
                        <p>Trending</p>
                    </div>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-bed"></i>
                        <p>Rooms</p>
                    </div>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-mountain-city"></i>
                        <p>Mountain City</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-mountain"></i>
                        <p>Mountain</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-brands fa-fort-awesome"></i>
                        <p>Castle</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-person-swimming"></i>
                        <p>Pool</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-fire-burner"></i>
                        <p>Camping</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-cow"></i>
                        <p>Farms</p>
                    </div>
                </div>
                <div class="filter">
                    <div><i class="fa-regular fa-snowflake"></i>
                        <p>Arctic</p>
                    </div>
                </div>

            </div>
            <div class="tax-toggle flex-shrink-0">
                <div class="form-check-reverse form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label" for="switchCheckDefault">Display total after Taxes</label>
                </div>
            </div>
        </div>



        <div class="row row-cols-lg-3 row-cols-md-2  row-cols-sm-1 row-cols-xs-1 mt-3">
            <% for(let listings of allListings){ %>
                <a href="/listings/<%= listings._id %>" class="listing-link">
                    <div class="card col listing-cards">
                        <img src=<%=listings.image.url %>
                        class="card-img-top"
                        alt="listings.image"
                        style="height: 20rem;"
                        />
                        <div class="card-img-overlay"> </div>
                        <div class="card-body">
                            <p class="card-text">
                                <b>
                                    <%= listings.title%> <br />
                                </b>
                                &#8377; <%= listings.price.toLocaleString("en-IN") %> / night
                            </p>
                        </div>
                    </div>
                </a>
                <%}%>
        </div>

        <script>
            let taxSwitch = document.getElementById("switchCheckDefault");
            taxSwitch.addEventListener("click", () => {
                console.log("Clicked")
            })
        </script>
    </body>